# mul.tasm -- multiply 6 * 8 via repeated addition (R0 = R1 * R2)
#   R0 = 0 (accumulator)
#   R1 = multiplier (8)
#   R2 = multiplicand (6)
#   loop: if R1 == 0 -> done
#         R0 = R0 + R2 ; R1 = R1 - 1 ; JNZ loop
LOAD  R0  0
LOAD  R1  8
LOAD  R2  6
LOOP:
JZ    DONE R1
ADD   R0  R2
LOAD  R3  1
SUB   R1  R3
JNZ   LOOP R1
DONE:
OUT   R0
HALT
